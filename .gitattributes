# Normalize line endings for all text files
* text=auto

# PHP files — LF
*.php text eol=lf

# Web files — LF
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# Config files — LF
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.pot text eol=lf
*.po text eol=lf

# Docs — LF
*.md text eol=lf
*.txt text eol=lf

# Windows-specific — keep CRLF
*.bat text eol=crlf
